{
  "name": "agent-team-kit",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted private agent teams with approvals, audit and rollback",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/therain2020/agent-team-kit.git"
  },
  "homepage": "https://github.com/therain2020/agent-team-kit",
  "bugs": {
    "url": "https://github.com/therain2020/agent-team-kit/issues"
  },
  "keywords": [
    "ai-agents",
    "agent-team",
    "multi-agent",
    "agent-orchestration",
    "autonomy",
    "self-hosted",
    "local-first",
    "typescript",
    "bun",
    "temporal",
    "deepseek"
  ],
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "kit": "bun run apps/cli/src/index.ts",
    "test": "bunx vitest run",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "bunx biome check .",
    "dev:up": "docker compose -f deploy/docker-compose.yml up -d",
    "dev:down": "docker compose -f deploy/docker-compose.yml down",
    "worker": "tsx apps/runtime/src/temporal/worker.ts",
    "autopilot": "tsx apps/runtime/src/autopilot.ts",
    "smoke:recovery": "tsx apps/runtime/src/temporal/recovery-smoke.ts",
    "drill:kill-switch": "tsx scripts/kill-switch-drill.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build",
    "web:start": "bun run --cwd apps/web start",
    "web:prod": "bun run web:build && bun run web:start",
    "bench:web": "bun run scripts/bench-web.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@swc/core",
    "esbuild",
    "protobufjs"
  ]
}
