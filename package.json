{
  "name": "agent-team-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "kit": "bun run apps/cli/src/index.ts",
    "test": "bunx vitest run",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "lint": "bunx biome check .",
    "dev:up": "docker compose -f deploy/docker-compose.yml up -d",
    "dev:down": "docker compose -f deploy/docker-compose.yml down",
    "worker": "tsx apps/runtime/src/temporal/worker.ts",
    "autopilot": "tsx apps/runtime/src/autopilot.ts",
    "smoke:recovery": "tsx apps/runtime/src/temporal/recovery-smoke.ts",
    "web:dev": "bun run --cwd apps/web dev",
    "web:build": "bun run --cwd apps/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@swc/core",
    "esbuild",
    "protobufjs"
  ]
}
