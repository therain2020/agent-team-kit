# Store
KIT_DB_URL=postgres://kit:kit@localhost:5432/kit
KIT_BLOB_BACKEND=fs
KIT_BLOB_ROOT=.tmp/blobs

# Use these when KIT_BLOB_BACKEND=s3
# KIT_S3_ENDPOINT=http://localhost:9000
# KIT_S3_REGION=us-east-1
# KIT_S3_ACCESS_KEY=kit
# KIT_S3_SECRET_KEY=change-me
# KIT_S3_BUCKET=kit

# Model gateway (M1+)
# DEEPSEEK_API_KEY=replace-me
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Manager Console (local)
NEXT_PUBLIC_TEMPORAL_UI_URL=http://localhost:8080
NEXT_PUBLIC_JAEGER_UI_URL=http://localhost:16686
# The console is served from a production build by default; use dev while editing
# KIT_WEB_MODE=dev
# Optional bearer/cookie gate for mutating routes (not enforced by the UI yet)
# KIT_UI_TOKEN=replace-me

# Open platform
# KIT_APPROVAL_TOKEN=replace-me
# KIT_APPROVAL_WEBHOOK_TOKEN=replace-me
# GITHUB_TOKEN=replace-me
# KIT_AUTOPILOT_DISABLED=1
# KIT_AUTOPILOT_INTERVAL_MS=30000
# KIT_SOURCES_ROOT=./sources

# Delivery (workflow delivery.channel: email | webhook | im | local_file)
# QQ Mail: enable SMTP and use the authorization code, not the password.
# KIT_SMTP_HOST=smtp.qq.com
# KIT_SMTP_PORT=465
# KIT_SMTP_SECURE=1
# KIT_SMTP_USER=you@example.com
# KIT_SMTP_PASS=authorization-code
# KIT_DELIVERY_EMAIL_TO=you@example.com
# KIT_DELIVERY_EMAIL_FROM=you@example.com
# KIT_DELIVERY_WEBHOOK_URL=https://example.com/hooks/kit
# KIT_DELIVERY_WEBHOOK_SECRET=replace-me

# Tool loop (repo/security/UX agents)
# KIT_TOOL_MAX_STEPS=10
# KIT_TOOL_MAX_CALLS=24
# KIT_TOOLS_ALLOW_NETWORK=0
# KIT_TOOLS_ALLOW_LOCALHOST=1
# KIT_BROWSE_BIN=C:\path\to\browse.exe
